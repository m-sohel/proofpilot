# ProofPilot Environment Configuration
# Copy to .env and adjust values

# LLM Provider: "ollama" | "mock"
LLM_PROVIDER=mock

# Ollama settings (only used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

# App settings
APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_URL=sqlite:///proofpilot.db
DEMO_MODE=false

# Logging
LOG_LEVEL=INFO
